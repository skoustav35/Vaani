{
  "compilerOptions": {
    "tsBuildInfoFile": "./.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client", "node"],
    "skipLibCheck": true,
    "allowJs": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "react": ["./nm2/node_modules/@types/react", "./nm2/node_modules/react"],
      "react-dom": ["./nm2/node_modules/@types/react-dom", "./nm2/node_modules/react-dom"],
      "react-dom/client": ["./nm2/node_modules/@types/react-dom/client", "./nm2/node_modules/react-dom/client"],
      "react/jsx-runtime": ["./nm2/node_modules/@types/react/jsx-runtime", "./nm2/node_modules/react/jsx-runtime"],
      "react/jsx-dev-runtime": ["./nm2/node_modules/@types/react/jsx-dev-runtime", "./nm2/node_modules/react/jsx-dev-runtime"],
      "*": ["./node_modules/*", "./nm2/node_modules/*"]
    }
  },
  "include": ["src"]
}
